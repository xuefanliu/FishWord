<Window x:Class="FishWord.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FishWord"
        Icon="Assets/logo.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        ResizeMode="NoResize"
        Width="240" Height="320"
        Left="120" Top="120">

    <Grid>
        <!-- 折叠态：小气泡 -->
        <Border x:Name="CollapsedView"
                Visibility="Collapsed"
                Width="46" Height="46"
                CornerRadius="23"
                Background="{DynamicResource Brush.BubbleBg}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
            <Grid>
                <TextBlock x:Name="BubbleProgressText"
                           Text="0/30"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.IconFg}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 展开态：完整面板 -->
        <Border x:Name="ExpandedView"
                CornerRadius="12"
                Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：返回 + 标题 + 进度 + 折叠/关闭 -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Grid Margin="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton" Content="←" Width="18" Height="18" Padding="0"
                                    FontSize="11" Background="Transparent" Foreground="{DynamicResource Brush.IconFg}"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    Click="Back_Click" ToolTip="返回首页" Visibility="Collapsed"/>
                            <TextBlock Text="FishWord" FontWeight="Bold" Foreground="{DynamicResource Brush.IconFg}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ProgressText" Text="" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Right" FontSize="11" Margin="0,0,52,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="20" Height="20" Padding="0"
                                    Background="Transparent"
                                    Click="Settings_Click" ToolTip="设置">
                                <!-- 6 齿齿轮矢量图标（Unicode ⚙ 在 Segoe UI 里 8 齿太密，小尺寸像花） -->
                                <Path Stretch="Uniform" Width="13" Height="13" Fill="{DynamicResource Brush.IconFg}">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <PathGeometry Figures="M 21.70 9.58 L 21.70 14.42 L 18.06 15.50 L 18.95 19.19 L 14.76 21.61 L 12.00 19.00 L 9.24 21.61 L 5.05 19.19 L 5.94 15.50 L 2.30 14.42 L 2.30 9.58 L 5.94 8.50 L 5.05 4.81 L 9.24 2.39 L 12.00 5.00 L 14.76 2.39 L 18.95 4.81 L 18.06 8.50 Z"/>
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="12,12" RadiusX="3.4" RadiusY="3.4"/>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                            </Button>
                            <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10"
                                    Background="Transparent" Foreground="{DynamicResource Brush.IconFg}"
                                    Click="Close_Click" ToolTip="收起为气泡（退出程序请用托盘菜单）"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区：五个视图 -->
                <Grid Grid.Row="1">

                    <!-- ============ 首页 ============ -->
                    <Grid x:Name="HomeView" Margin="14,6,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 日期行 + 查看熟词 -->
                        <Grid Grid.Row="0" Margin="0,2,0,10">
                            <TextBlock x:Name="HomeDateText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="KnownWordsButton" Content="查看熟词" FontSize="10" Padding="8,3"
                                    HorizontalAlignment="Right" Background="{DynamicResource Brush.CardStrongBg}" Foreground="{DynamicResource Brush.Text.Primary}"
                                    Click="KnownWords_Click"/>
                        </Grid>

                        <!-- 学习 / 复习 卡片 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Brush.CardStrongBg}" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="学习" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                        <Button x:Name="CurrentBookButton" Content="词书" FontSize="9" Padding="5,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.TabSelected}" Foreground="{DynamicResource Brush.ButtonFg}"
                                                Click="SwitchBook_Click" ToolTip="切换词书"/>
                                    </Grid>
                                    <TextBlock x:Name="StudyCountText" Text="0 / 30" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,8,0,8"/>
                                    <Button x:Name="StudyButton" Content="去学习" FontSize="11" Padding="8,4"
                                            Click="Study_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource Brush.CardStrongBg}" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="复习" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock x:Name="ReviewCountText" Text="0 / 0" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,8,0,8"/>
                                    <Button x:Name="ReviewButton" Content="去复习" FontSize="11" Padding="8,4"
                                            Click="Review_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ 学习面板 ============ -->
                    <Grid x:Name="StudyView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ContentScroller" Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                      Margin="14,6,12,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <TextBlock x:Name="SpellingText" Text="word" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Button x:Name="AudioButton" Content="🔊" Width="24" Height="24" Padding="0"
                                                Background="Transparent" Foreground="{DynamicResource Brush.IconFg}" FontSize="13"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Click="AudioButton_Click" ToolTip="发音"/>
                                    </StackPanel>
                                    <Button x:Name="KnownWordButton" Grid.Column="1" Content="熟" Width="26" Height="26" Padding="0"
                                            Background="{DynamicResource Brush.TabSelected}" Foreground="{DynamicResource Brush.ButtonFg}" FontSize="12" VerticalAlignment="Center"
                                            ToolTip="标记为熟词，后续不再单独安排学习和复习" Click="KnownWord_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="PhoneticText" Text="/wɜːd/" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                <!-- 语素拆分：一行小字，跟在音标后（无标题），无可拆分时隐藏 -->
                                <TextBlock x:Name="MorphText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="PassText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0"/>

                                <Border x:Name="MeaningBox" Background="{DynamicResource Brush.CardStrongBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                    <TextBlock x:Name="MeaningText" Text="" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- 详情 Tab：例句 / 派生 / 词根 / 词源（恒显示，无数据的板块内容显示"暂无"） -->
                                <StackPanel x:Name="DetailTabBar" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Button x:Name="TabExampleButton" Content="例句" Style="{StaticResource DetailTabButtonStyle}"
                                            Click="TabExample_Click"/>
                                    <Button x:Name="TabDerivButton" Content="派生" Style="{StaticResource DetailTabButtonStyle}"
                                            Click="TabDeriv_Click"/>
                                    <Button x:Name="TabRootButton" Content="词根" Style="{StaticResource DetailTabButtonStyle}"
                                            Click="TabRoot_Click"/>
                                    <Button x:Name="TabEtymButton" Content="词源" Style="{StaticResource DetailTabButtonStyle}"
                                            Click="TabEtym_Click"/>
                                </StackPanel>

                                <Border x:Name="ExampleBox" Background="{DynamicResource Brush.CardBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ExampleEmptyText" Text="暂无例句" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed"/>
                                        <ItemsControl x:Name="ExamplesList" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DervBox" Background="{DynamicResource Brush.CardBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="DervEmptyText" Text="暂无派生词" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DervText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="RootBox" Background="{DynamicResource Brush.CardBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="RootEmptyText" Text="暂无词根信息" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="RootText" Text="" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="FamilyText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="EtymBox" Background="{DynamicResource Brush.CardBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="EtymEmptyText" Text="暂无词源" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="EtymologyText" Text="" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,12">
                            <Button x:Name="ViewButton" Content="查看" Width="70" Height="30" Margin="4,0"
                                    Click="ViewButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="RememberButton" Content="记住了" Width="70" Height="30" Margin="4,0"
                                    Click="RememberButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="ForgotButton" Content="没记住" Width="70" Height="30" Margin="4,0"
                                    Click="ForgotButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="NextButton" Content="下一个" Width="84" Height="30" Margin="4,0"
                                    Click="NextButton_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 熟词列表（手风琴） ============ -->
                    <Grid x:Name="KnownView" Visibility="Collapsed" Margin="14,6,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="熟词列表" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="UserTabButton" Content="我的熟词" Tag="user" FontSize="10" Padding="8,3"
                                    Background="{DynamicResource Brush.TabSelected}" Foreground="{DynamicResource Brush.ButtonFg}" Cursor="Hand" Click="KnownTab_Click"/>
                            <Button x:Name="SystemTabButton" Content="系统排除" Tag="system" FontSize="10" Padding="8,3"
                                    Background="{DynamicResource Brush.CardStrongBg}" Foreground="{DynamicResource Brush.Text.Secondary}" Cursor="Hand" Margin="6,0,0,0" Click="KnownTab_Click"/>
                        </StackPanel>
                        <ListBox x:Name="KnownList" Grid.Row="2"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                        <Border Background="{DynamicResource Brush.CardBg}" CornerRadius="8" Margin="0,3" Padding="8,6">
                                            <StackPanel>
                                                <!-- 头部行：单词 + 播放 + 取消（点击单词区展开/收起） -->
                                                <Grid MouseLeftButtonUp="KnownRow_Toggle" Background="Transparent" Cursor="Hand">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Word.Spelling}" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="🔊" Width="22" Height="22" Padding="0" FontSize="11"
                                                            Background="Transparent" Foreground="{DynamicResource Brush.IconFg}" VerticalAlignment="Center" Margin="4,0,2,0"
                                                            Click="KnownAudio_Click" ToolTip="发音"/>
                                                    <Button Grid.Column="2" Content="取消" FontSize="9" Padding="8,4" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.CardStrongBg}" Foreground="{DynamicResource Brush.Text.Primary}"
                                                            Click="UnmarkKnown_Click" ToolTip="取消熟词"/>
                                                </Grid>

                                                <!-- 详情区（手风琴展开，仅音标 + 释义） -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="{Binding PhoneticDisplay}" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                                    <Border Background="{DynamicResource Brush.CardStrongBg}" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding DefinitionsDisplay}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ============ 设置 ============ -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="14,6,14,14">
                        <StackPanel>
                            <TextBlock Text="每日学习数量" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button x:Name="GoalMinusButton" Content="−" Width="30" Height="30" FontSize="16" Padding="0"
                                        Click="GoalMinus_Click"/>
                                <TextBlock x:Name="GoalText" Text="10" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="18,0" VerticalAlignment="Center"/>
                                <Button x:Name="GoalPlusButton" Content="＋" Width="30" Height="30" FontSize="16" Padding="0"
                                        Click="GoalPlus_Click"/>
                            </StackPanel>

                            <TextBlock Text="收起快捷键" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Background="{DynamicResource Brush.CardStrongBg}" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="HotKeyText" Text="Ctrl+Alt+W" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </Border>
                                <Button x:Name="HotKeyButton" Content="设置" FontSize="10" Padding="8,3" Margin="8,0,0,0"
                                        Click="HotKey_Click"/>
                            </StackPanel>

                            <TextBlock Text="主题" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="DarkThemeButton" Content="深色" FontSize="10" Padding="10,3"
                                        Style="{StaticResource DetailTabButtonStyle}" Click="DarkTheme_Click"/>
                                <Button x:Name="LightThemeButton" Content="浅色" FontSize="10" Padding="10,3"
                                        Style="{StaticResource DetailTabButtonStyle}" Margin="4,0,0,0" Click="LightTheme_Click"/>
                            </StackPanel>

                            <Button x:Name="SaveSettingsButton" Content="保存" Margin="0,8,0,0"
                                    Click="SaveSettings_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============ 词书选择 ============ -->
                    <Grid x:Name="BookSelectView" Visibility="Collapsed" Margin="14,6,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="选择词书" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="BookList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,3" Padding="10,8" Click="BookSelect_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CountDisplay}" FontSize="9"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="✓ 当前" FontSize="10" Foreground="{DynamicResource Brush.Accent}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
